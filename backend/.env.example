APP_NAME=临床数据收集系统
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api

DATABASE_URL=postgresql+psycopg://clinical_user:clinical_pass@localhost:5432/clinical_data

JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FILE_STORAGE_ROOT=../data-dev/file-storage
MAX_UPLOAD_SIZE_MB=200
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

