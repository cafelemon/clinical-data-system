APP_NAME=临床数据收集系统
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api

DATABASE_URL=postgresql+psycopg://clinical_user:replace-with-strong-postgres-password@postgres:5432/clinical_data

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-after-first-login
INITIAL_ADMIN_FULL_NAME=系统管理员
INITIAL_ADMIN_EMAIL=

FILE_STORAGE_ROOT=/data/file-storage
MAX_UPLOAD_SIZE_MB=200

PDF_PACKET_OCR_API_URL=http://paddle-ocr-api:8000
PDF_PACKET_OCR_DPI=120
PDF_PACKET_OCR_TIMEOUT_SECONDS=1800
PDF_PACKET_OCR_COMMAND=

BACKEND_CORS_ORIGINS=["http://localhost:18080"]
